{
  "info": {
    "name": "Bibliotech Circulation Systems - Microservices Platform",
    "description": "End-to-End Postman Collection for Enterprise Academic Resource & Circulation Management Platform.\nRoutes all requests through Spring Cloud API Gateway (http://localhost:8080) with Eureka Service Discovery, JWT Authentication, Role-based Authorization, and Inter-service Communication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:8080" },
    { "key": "student_token", "value": "" },
    { "key": "librarian_token", "value": "" },
    { "key": "book_id", "value": "1" },
    { "key": "loan_id", "value": "1" },
    { "key": "fine_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Authentication & Users",
      "item": [
        {
          "name": "1.1 Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dhanya_student\",\n  \"password\": \"studentPass123\",\n  \"role\": \"STUDENT\"\n}"
            },
            "url": { "raw": "{{gateway_url}}/auth/register", "host": ["{{gateway_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "1.2 Login Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"student_token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dhanya_student\",\n  \"password\": \"studentPass123\"\n}"
            },
            "url": { "raw": "{{gateway_url}}/auth/login", "host": ["{{gateway_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.3 Register Librarian",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_librarian\",\n  \"password\": \"adminPass123\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": { "raw": "{{gateway_url}}/auth/register", "host": ["{{gateway_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "1.4 Login Librarian",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"librarian_token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_librarian\",\n  \"password\": \"adminPass123\"\n}"
            },
            "url": { "raw": "{{gateway_url}}/auth/login", "host": ["{{gateway_url}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Book Management (Inventory)",
      "item": [
        {
          "name": "2.1 Add Book (Librarian Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.bookId) {",
                  "    pm.collectionVariables.set(\"book_id\", jsonData.bookId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{librarian_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Native Microservices with Spring Boot\",\n  \"author\": \"Martin Fowler\",\n  \"availableCopies\": 2\n}"
            },
            "url": { "raw": "{{gateway_url}}/books", "host": ["{{gateway_url}}"], "path": ["books"] }
          }
        },
        {
          "name": "2.2 Get All Books (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gateway_url}}/books", "host": ["{{gateway_url}}"], "path": ["books"] }
          }
        },
        {
          "name": "2.3 Get Book By ID (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gateway_url}}/books/{{book_id}}", "host": ["{{gateway_url}}"], "path": ["books", "{{book_id}}"] }
          }
        },
        {
          "name": "2.4 Check Book Availability (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gateway_url}}/books/{{book_id}}/available", "host": ["{{gateway_url}}"], "path": ["books", "{{book_id}}", "available"] }
          }
        }
      ]
    },
    {
      "name": "3. Loan & Circulation Lifecycle",
      "item": [
        {
          "name": "3.1 Borrow Book as Student (Copies Decrease)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.loanId) {",
                  "    pm.collectionVariables.set(\"loan_id\", jsonData.loanId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"bookId\": {{book_id}}\n}"
            },
            "url": { "raw": "{{gateway_url}}/loans", "host": ["{{gateway_url}}"], "path": ["loans"] }
          }
        },
        {
          "name": "3.2 Try Duplicate Borrow (Expect 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"bookId\": {{book_id}}\n}"
            },
            "url": { "raw": "{{gateway_url}}/loans", "host": ["{{gateway_url}}"], "path": ["loans"] }
          }
        },
        {
          "name": "3.3 Second User Borrows Last Copy",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"bookId\": {{book_id}}\n}"
            },
            "url": { "raw": "{{gateway_url}}/loans", "host": ["{{gateway_url}}"], "path": ["loans"] }
          }
        },
        {
          "name": "3.4 Third User Attempts Borrow on 0 Copies (Expect 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"bookId\": {{book_id}}\n}"
            },
            "url": { "raw": "{{gateway_url}}/loans", "host": ["{{gateway_url}}"], "path": ["loans"] }
          }
        },
        {
          "name": "3.5 Return Book (Loan -> Fine -> Book Flow)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": { "raw": "{{gateway_url}}/loans/{{loan_id}}/return", "host": ["{{gateway_url}}"], "path": ["loans", "{{loan_id}}", "return"] }
          }
        },
        {
          "name": "3.6 Try Duplicate Return (Expect 409 Conflict)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": { "raw": "{{gateway_url}}/loans/{{loan_id}}/return", "host": ["{{gateway_url}}"], "path": ["loans", "{{loan_id}}", "return"] }
          }
        },
        {
          "name": "3.7 View Loan Details (Return Date Populated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": { "raw": "{{gateway_url}}/loans/{{loan_id}}", "host": ["{{gateway_url}}"], "path": ["loans", "{{loan_id}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Overdue Tracking & Notifications",
      "item": [
        {
          "name": "4.1 View Overdue Loans (Librarian)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{librarian_token}}" }
            ],
            "url": { "raw": "{{gateway_url}}/loans/overdue", "host": ["{{gateway_url}}"], "path": ["loans", "overdue"] }
          }
        },
        {
          "name": "4.2 Trigger Overdue Notification Dispatch (Librarian)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{librarian_token}}" }
            ],
            "url": { "raw": "{{gateway_url}}/loans/overdue/notify", "host": ["{{gateway_url}}"], "path": ["loans", "overdue", "notify"] }
          }
        }
      ]
    },
    {
      "name": "5. Fine Management",
      "item": [
        {
          "name": "5.1 Get Fines by Rental/Loan ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": { "raw": "{{gateway_url}}/fines/rental/{{loan_id}}", "host": ["{{gateway_url}}"], "path": ["fines", "rental", "{{loan_id}}"] }
          }
        },
        {
          "name": "5.2 Student Tries to Settle Fine (Expect 403 Forbidden)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": { "raw": "{{gateway_url}}/fines/{{fine_id}}/pay", "host": ["{{gateway_url}}"], "path": ["fines", "{{fine_id}}", "pay"] }
          }
        },
        {
          "name": "5.3 Librarian Marks Fine as Paid (Expect 200 OK)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{librarian_token}}" }
            ],
            "url": { "raw": "{{gateway_url}}/fines/{{fine_id}}/pay", "host": ["{{gateway_url}}"], "path": ["fines", "{{fine_id}}", "pay"] }
          }
        }
      ]
    },
    {
      "name": "6. Security & Negative Test Cases",
      "item": [
        {
          "name": "6.1 Student Attempts Librarian Operation (Expect 403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Book\",\n  \"author\": \"Hacker\",\n  \"availableCopies\": 1\n}"
            },
            "url": { "raw": "{{gateway_url}}/books", "host": ["{{gateway_url}}"], "path": ["books"] }
          }
        },
        {
          "name": "6.2 Missing JWT on Protected Endpoint (Expect 401 Unauthorized)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gateway_url}}/loans", "host": ["{{gateway_url}}"], "path": ["loans"] }
          }
        },
        {
          "name": "6.3 Invalid JWT on Protected Endpoint (Expect 401 Unauthorized)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer invalidTokenABC123XYZ" }
            ],
            "url": { "raw": "{{gateway_url}}/loans", "host": ["{{gateway_url}}"], "path": ["loans"] }
          }
        }
      ]
    }
  ]
}
